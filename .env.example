# RAG Workbench configuration.
# Copy to `.env` and edit as needed. Every value is optional; the defaults below
# are what the application uses when a variable is unset.

# Directory holding the SQLite database, uploaded documents and other local state.
RAG_WORKBENCH_DATA_DIR=data

# Explicit SQLAlchemy database URL. If unset, a SQLite file inside DATA_DIR is used.
# RAG_WORKBENCH_DATABASE_URL=sqlite:///data/rag_workbench.db

# Maximum accepted upload size, in megabytes.
RAG_WORKBENCH_MAX_UPLOAD_MB=25

# Allowed upload extensions, as a JSON array.
RAG_WORKBENCH_ALLOWED_EXTENSIONS=[".txt", ".md", ".markdown", ".pdf"]

# Log level for the structured JSON logger (DEBUG, INFO, WARNING, ERROR).
RAG_WORKBENCH_LOG_LEVEL=INFO

# Default collection (dataset) name used when a request does not specify one.
RAG_WORKBENCH_DEFAULT_COLLECTION=default

# Default chunking strategy: "paragraph" (recursive/paragraph-aware) or "fixed_token".
RAG_WORKBENCH_DEFAULT_CHUNK_STRATEGY=paragraph
RAG_WORKBENCH_DEFAULT_MAX_TOKENS=220
RAG_WORKBENCH_DEFAULT_OVERLAP_TOKENS=40

# --- Dense retrieval (only used when a dense profile is created with --embed / embed=true).

# Default Sentence Transformers model. Requires: uv sync --extra dense
RAG_WORKBENCH_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector dimension. Derived for the default model (384); required for unknown models.
# RAG_WORKBENCH_EMBEDDING_DIMENSION=384

# Optional pinned model revision.
# RAG_WORKBENCH_EMBEDDING_REVISION=

RAG_WORKBENCH_EMBEDDING_BATCH_SIZE=32
RAG_WORKBENCH_EMBEDDING_NORMALIZE=true

# Vector store directory, relative to DATA_DIR (Qdrant local mode; single-owner).
RAG_WORKBENCH_VECTOR_DIR_NAME=qdrant

# Candidate pool size for dense/hybrid retrieval, and the RRF constant.
RAG_WORKBENCH_DENSE_CANDIDATE_K=50
RAG_WORKBENCH_RRF_K=60

# Base URL the Streamlit UI uses to reach the FastAPI backend.
RAG_WORKBENCH_API_URL=http://127.0.0.1:8000

# --- Cross-encoder reranking (only used when a search requests rerank=true).
# Requires the same optional extra as dense retrieval: uv sync --extra dense
RAG_WORKBENCH_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
# RAG_WORKBENCH_RERANKER_REVISION=
RAG_WORKBENCH_RERANKER_BATCH_SIZE=32
# RAG_WORKBENCH_RERANKER_MAX_LENGTH=
RAG_WORKBENCH_RERANK_CANDIDATES=20

# --- Retrieval evaluation, benchmarking and failure analysis.
# Default candidate-pool depth and rank cut-offs used by the Evaluation Lab.
RAG_WORKBENCH_DEFAULT_CANDIDATE_DEPTH=100
# RAG_WORKBENCH_DEFAULT_EVAL_K=[1, 3, 5, 10]
# Writable dataset root (imported/BEIR datasets), relative to DATA_DIR.
RAG_WORKBENCH_DATASET_DIR_NAME=datasets
# Bundled, committed datasets shipped with the repository.
# RAG_WORKBENCH_BUNDLED_DATASETS_DIR=datasets
# Committed experiment artifacts shown in read-only deployments.
# RAG_WORKBENCH_RECORDED_EXPERIMENTS_DIR=benchmarks/recorded

# --- Public read-only demonstration mode.
# When true the backend refuses every mutating endpoint (403) and serves only
# reads plus the committed datasets/experiments.
RAG_WORKBENCH_READ_ONLY=false
# Trusted internal bootstrap: seed the bundled sample corpus once at startup so a
# fresh read-only instance still has something to search.
RAG_WORKBENCH_AUTOSEED_SAMPLE=false
